# Must match backend GOOGLE_OAUTH_CLIENT_ID (public Web client id).
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Production API (Render / other host). Leave unset for local dev (localhost:8001).
# VITE_API_BASE_URL=https://your-api.onrender.com

# Optional local-only companion to backend ALLOW_DEV_USER_HEADER=true.
# The generated ID must already exist in the local users table.
# VITE_ALLOW_DEV_USER_HEADER=true
